// Copy this file to `Secrets.xcconfig` and fill it in.
//
//     cp ios-app/Secrets.example.xcconfig ios-app/Secrets.xcconfig
//
// `Secrets.xcconfig` is git-ignored. The assignment's rules forbid committing
// API tokens, GitHub tokens or private endpoint URLs, so nothing real belongs
// in this template.

// ---------------------------------------------------------------------------
// Assignment 2 ImageBind service
// ---------------------------------------------------------------------------
// xcconfig treats `//` as a comment *anywhere* on a line, which silently eats
// the `https://` in a URL. That is why the scheme is a separate key and the
// endpoint is written without it.
IMAGEBIND_SCHEME = https
IMAGEBIND_ENDPOINT = your-colab-tunnel.example.dev
IMAGEBIND_TOKEN =

// ---------------------------------------------------------------------------
// Feature switches
// ---------------------------------------------------------------------------
// Audio is the modality that separates walking from running. Leave it on
// unless you are isolating vision performance.
AUDIO_ENABLED = YES

// Spoken results need A2DP; capture needs HFP; the two cannot be active at
// once. Turning this on costs ~2 s of route re-acquisition on the following
// trial, so keep it off for timed runs and on for the voice demo.
SPEECH_ENABLED = NO

// NO talks to physical glasses. Set YES to run against the official Mock
// Device Kit instead — but note the kit has no display emulation, so on that
// path the HUD is rendered by the phone mirror and the glasses show nothing.
//
// Defaulting to NO deliberately: a template that ships YES means a fresh
// checkout silently starts in mock mode and fails at startup looking for
// fixture files the README has not told you to create yet.
USE_MOCK_DEVICE = NO

// ---------------------------------------------------------------------------
// Meta Wearables Developer Center
// ---------------------------------------------------------------------------
// In Meta AI Developer Mode these may stay 0: registration is always allowed
// and attestation is skipped. Fill them in for a release-channel build.
MWDAT_APPLICATION_ID = 0
MWDAT_CLIENT_TOKEN = 0
